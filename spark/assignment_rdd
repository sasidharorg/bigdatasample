from pyspark import SparkContext
from bs4 import BeautifulSoup


def extract_data_between_tags(html_file, tag_name):
    # Initialize SparkContext
    sc = SparkContext.getOrCreate()

    # Read the file as an RDD
    rdd = sc.textFile(html_file)

    # Collect RDD into a single HTML content string
    html_content = "\n".join(rdd.collect())

    # Parse the HTML content
    soup = BeautifulSoup(html_content, 'html.parser')

    # Extract data between the specified tags
    data = []
    for tag in soup.find_all(tag_name):
        data.append(tag.text)

    # Return as an RDD
    extracted_data_rdd = sc.parallelize(data)
    return extracted_data_rdd


